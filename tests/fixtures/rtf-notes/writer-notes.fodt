<office:body><office:text>
<text:p>Body A<text:note text:id="ftn1" text:note-class="footnote"><text:note-citation>1</text:note-citation><text:note-body><text:p>First footnote.</text:p><text:p>Second note paragraph.</text:p></text:note-body></text:note> B.</text:p>
<text:p>Body C<text:note text:id="end1" text:note-class="endnote"><text:note-citation>i</text:note-citation><text:note-body><text:p>Separate endnote.</text:p></text:note-body></text:note> D.</text:p>
<text:p>Body E<text:note text:id="custom" text:note-class="footnote"><text:note-citation text:label="*">*</text:note-citation><text:note-body><text:p>Custom marked note.</text:p></text:note-body></text:note> F.</text:p>
