+          b.Size > item.PackSize - packed) return E_FAIL;
+      end = b.Offset + b.Size;
+      packed += b.Size;
+    }
+    if (packed != item.PackSize) return E_FAIL;
+    item.SparseBlocks.Clear();
+    FOR_VECTOR(i, Blocks)
