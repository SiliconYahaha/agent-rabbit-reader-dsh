+
+// GNU PAX sparse maps describe logical offsets, not bytes in the archive.
+// Keep map storage bounded independently of the selected output byte limit.
+static const unsigned kSparseBlocksMax = 65536;
+
+static bool SparseNumber(const char *&p, UInt64 &n)
+{
+  const char *start = p;
+  n = 0;
+  while (*p >= '0' && *p <= '9')
+  {
+    const unsigned digit = (unsigned)(*p++ - '0');
+    if (n > (((UInt64)1 << 63) - 1 - digit) / 10)
+      return false;
+    n = n * 10 + digit;
+  }
+  return p != start;
+}
+
+struct CPaxSparse
+{
+  enum { kSize = 1, kCount = 2, kMap = 4, kMajor = 8,
+    kMinor = 16, kRealSize = 32, kName = 64, kPairs = 128 };
+  unsigned Flags;
+  bool Present, Bad, PendingOffset;
+  UInt64 Size, Count, Major, Minor, RealSize, Offset;
+  AString Name;
+  CRecordVector<CSparseBlock> Blocks;
+
+  CPaxSparse(): Flags(0), Present(false), Bad(false), PendingOffset(false),
+    Size(0), Count(0), Major(0), Minor(0), RealSize(0), Offset(0) {}
+
+  bool Add(UInt64 offset, UInt64 size)
+  {
+    if (Blocks.Size() >= kSparseBlocksMax)
+      return false;
+    CSparseBlock b;
+    b.Offset = offset;
+    b.Size = size;
+    Blocks.Add(b);
+    return true;
+  }
+
+  bool Parse(const AString &key, const AString &value)
+  {
+    Present = true;
+    const char *p = value.Ptr();
+    UInt64 n = 0;
+    unsigned flag = 0;
+    if (key.IsEqualTo("GNU.sparse.name"))
+    {
+      flag = kName;
+      if (value.IsEmpty()) return false;
+      Name = value;
+    }
+    else if (key.IsEqualTo("GNU.sparse.map"))
+    {
+      flag = kMap;
+      if (Flags & kPairs) return false;
+      Blocks.Clear(); // POSIX: the last map attribute replaces the previous one.
+      while (*p)
+      {
+        UInt64 off, len;
+        if (!SparseNumber(p, off) || *p++ != ',' ||
+            !SparseNumber(p, len) || !Add(off, len)) return false;
+        if (!*p) break;
+        if (*p++ != ',' || !*p) return false;
+      }
+    }
+    else
+    {
+      if (!SparseNumber(p, n) || *p) return false;
+      if (key.IsEqualTo("GNU.sparse.offset"))
+      {
+        if (PendingOffset || (Flags & kMap)) return false;
+        Flags |= kPairs;
+        PendingOffset = true;
+        Offset = n;
+        return true;
+      }
+      if (key.IsEqualTo("GNU.sparse.numbytes"))
+      {
+        if (!PendingOffset || !Add(Offset, n)) return false;
+        PendingOffset = false;
+        return true;
+      }
+      if (key.IsEqualTo("GNU.sparse.size")) { flag = kSize; Size = n; }
+      else if (key.IsEqualTo("GNU.sparse.numblocks")) { flag = kCount; Count = n; }
+      else if (key.IsEqualTo("GNU.sparse.major")) { flag = kMajor; Major = n; }
+      else if (key.IsEqualTo("GNU.sparse.minor")) { flag = kMinor; Minor = n; }
+      else if (key.IsEqualTo("GNU.sparse.realsize")) { flag = kRealSize; RealSize = n; }
+      else return false;
+    }
+    Flags |= flag;
+    return true;
+  }
