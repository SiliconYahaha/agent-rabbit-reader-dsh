+        return E_FAIL;
+      logicalSize = RealSize;
+      // Read complete map records only. A map may span many 512-byte records;
+      // its final record is zero padded before packed extent bytes begin.
+      Byte block[512];
+      UInt64 consumed = 0, number = 0, off = 0, expected = 1, index = 0;
+      unsigned digits = 0;
+      bool done = false;
+      while (!done)
+      {
+        if (item.PackSize - consumed < sizeof(block)) return E_FAIL;
+        size_t read = sizeof(block);
+        RINOK(ReadStream(stream, block, &read))
+        if (read != sizeof(block)) return E_FAIL;
+        consumed += sizeof(block);
+        for (unsigned i = 0; i < sizeof(block); i++)
+        {
+          const Byte c = block[i];
+          if (done)
+          {
+            if (c) return E_FAIL;
+            continue;
+          }
+          if (c >= '0' && c <= '9')
+          {
+            if (++digits > 20 || number > (((UInt64)1 << 63) - 1 - (c - '0')) / 10)
+              return E_FAIL;
+            number = number * 10 + (c - '0');
+            continue;
+          }
+          if (c != '\n' || !digits) return E_FAIL;
+          if (index == 0)
