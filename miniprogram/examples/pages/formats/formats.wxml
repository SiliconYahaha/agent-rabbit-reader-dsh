<view class="formats-page">
  <view class="formats-note">点格式查看扩展名与兼容范围</view>
  <button wx:for="{{formats}}" wx:key="id" class="format-info-row" data-id="{{item.id}}" bindtap="toggleFormat" aria-expanded="{{expanded === item.id}}">
    <view class="format-main">
      <format-icon label="{{item.iconLabel}}"/>
      <view class="format-info-copy">
        <view class="format-label">{{item.label}}</view>
        <view class="format-info-title">{{item.title}}<text wx:if="{{item.badge}}" class="format-badge">{{item.badge}}</text></view>
      </view>
      <text class="format-chevron">{{expanded === item.id ? '−' : '＋'}}</text>
    </view>
    <view wx:if="{{expanded === item.id}}" class="format-details">
      <text class="format-extensions">{{item.extensionText}}</text>
      <text class="format-usage">{{item.usage}}</text>
    </view>
  </button>
</view>
