.formats-page{padding:20rpx 32rpx 48rpx;color:var(--reader-ink)}
.formats-note{margin:4rpx 0 24rpx;color:var(--reader-muted);font-size:24rpx;line-height:1.6}
.formats-page .format-info-row{width:100%;box-sizing:border-box;margin:0 0 16rpx;padding:24rpx;border:1rpx solid rgba(23,23,21,.18);border-radius:20rpx;background:var(--reader-surface);text-align:left;line-height:1.4}
.format-info-row::after{border:0}.format-info-row:active{background:#f4f5e9}
.format-main{display:flex;align-items:center;gap:24rpx}.format-info-copy{flex:1;min-width:0}
.format-label{font-size:28rpx;font-weight:750}.format-info-title{margin-top:7rpx;font-size:24rpx;color:#625e55}
.format-badge{display:inline-block;margin-left:12rpx;font-size:19rpx;color:#755a34;background:#f4eddf;padding:3rpx 8rpx;border-radius:6rpx}
.format-chevron{flex:none;color:#716d65;font-size:26rpx}
.format-details{border-top:1rpx solid #e7e2d8;margin-top:22rpx;padding-top:18rpx}
.format-extensions{display:block;font-size:23rpx;font-weight:600;word-break:break-word;line-height:1.6}
.format-usage{display:block;margin-top:8rpx;font-size:23rpx;color:#716d65;line-height:1.6}

.format-info-title,.format-usage,.format-chevron{font-weight:400}
