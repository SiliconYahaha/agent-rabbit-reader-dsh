<view class="examples-page">
  <view class="examples-heading">选一种文件，看看能打开什么</view>
  <view class="examples-note">点卡片，就能打开一份真实示例。</view>
  <view wx:if="{{error}}" class="example-error" role="alert">{{error}}</view>
  <button wx:for="{{cards}}" wx:key="id" class="example-card" data-id="{{item.id}}" bindtap="openExample" disabled="{{!!opening}}" aria-label="{{item.format + '，' + item.usage + '，打开示例：' + item.title}}">
    <view class="example-format tone-{{item.tone}}">
      <format-icon label="{{item.iconLabel}}"/>
    </view>
    <view class="example-info">
      <view class="example-title">{{item.shortTitle}}</view>
      <view class="example-description">{{opening === item.id ? '正在打开…' : item.shortDetail}}</view>
    </view>
    <image class="example-preview" src="{{item.preview}}" mode="{{item.id === 'final' ? 'aspectFit' : 'aspectFill'}}" aria-hidden="true" />
  </button>
  <navigator class="example-card more-formats-card" url="/examples/pages/formats/formats" aria-label="支持更多格式，查看完整清单">
    <view class="example-format tone-more"><format-icon label="＋"/></view>
    <view class="example-info">
      <view class="example-title">支持更多格式</view>
      <view class="example-description">查看完整格式清单与兼容说明</view>
    </view>
    <text class="example-arrow">›</text>
  </navigator>
  <view class="examples-privacy"><image src="/assets/icons/shield-check.svg" mode="aspectFit" aria-hidden="true"/><text>本机处理 · 不上传原文件</text></view>
  <button class="examples-credits" bindtap="showCredits">示例说明与来源</button>
</view>
