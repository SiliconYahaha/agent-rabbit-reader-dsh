.preview-page {
  box-sizing: border-box;
  min-height: 100%;
  padding: 24rpx 32rpx 80rpx;
  color: #171715;
  background: #fff9f2;
}

.preview-image {
  display: block;
  box-sizing: border-box;
  width: 100%;
  border: 3rpx solid #171715;
  border-radius: 24rpx;
  background: #e8e5df;
  box-shadow: 8rpx 8rpx 0 #ff5b43;
}
