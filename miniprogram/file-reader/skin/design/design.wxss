/* file-reader 皮肤（Ai / PSD 预览）—— 宿主自有：颜色、间距、文案排布都在这里改，模块同步不会覆盖本目录。 */

.file-heading {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.file-mark {
  display: flex;
  flex: 0 0 94rpx;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 94rpx;
  height: 94rpx;
  border: 3rpx solid #171715;
  border-radius: 22rpx;
  color: #171715;
  background: #b9e63b;
  font-size: 24rpx;
  font-weight: 900;
  box-shadow: 5rpx 5rpx 0 #171715;
}

.file-copy { flex: 1; min-width: 0; }

.file-name { overflow: hidden; font-size: 30rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }

.file-size { margin-top: 6rpx; color: #716d65; font-size: 22rpx; }

.status-card,
.message-card,
.error-card,
.metadata-card {
  margin: 22rpx 0;
  padding: 24rpx;
  border: 3rpx solid #171715;
  border-radius: 22rpx;
  background: #fffdf8;
  font-size: 24rpx;
  line-height: 1.6;
}

.message-card { background: #f3f5e7; }

.error-card { color: #7f2119; background: #ffe7df; box-shadow: 6rpx 6rpx 0 #ff5b43; }

.card-title { margin-bottom: 12rpx; font-size: 28rpx; font-weight: 850; }

.metadata-row { display: flex; gap: 16rpx; padding: 10rpx 0; border-top: 1rpx solid #ded9cf; }

.metadata-label { flex: 0 0 150rpx; color: #716d65; }

.metadata-value { flex: 1; min-width: 0; font-weight: 650; word-break: break-all; }

.primary-button {
  width: 100%;
  min-height: 92rpx;
  margin-top: 24rpx;
  border: 3rpx solid #171715;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.primary-button { color: #fff; background: #ff5b43; box-shadow: 0 8rpx 0 #e74431; }
