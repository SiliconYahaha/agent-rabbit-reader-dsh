.design-shell{box-sizing:border-box;padding:32rpx 40rpx 64rpx;color:#171715;background:#fff9f2}
.status-card,.message-card,.error-card{padding:22rpx;margin:16rpx 0;border:1rpx solid rgba(23,23,21,.18);border-radius:18rpx;background:#fffdf8;font-size:25rpx;line-height:1.6}
.error-card{color:#7f2119;background:#ffe7df}
.preview-note{margin-top:20rpx;color:#716d65;font-size:22rpx;line-height:1.6}
.preview-note text{display:block}
.primary-button{margin-top:20rpx;background:#b9e63b;font-size:26rpx}
