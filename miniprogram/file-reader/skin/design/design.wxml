<skin-filebar name="{{name}}" size="{{size}}" metadata="{{metadata}}" message="{{message}}"/>
<view class="design-shell">
  <view wx:if="{{loading}}" class="status-card">{{loadingText}}</view>
  <slot name="preview"/>
  <view wx:if="{{message && hasPreview}}" class="preview-note">{{previewNotice}}<text>点击上方文件名查看说明</text></view>
  <view wx:if="{{message && !hasPreview}}" class="message-card">文件暂不支持<skin-feedback id="file-feedback" name="{{name}}"/></view>
  <view wx:if="{{error}}" class="error-card"><text>文件暂不支持</text><skin-feedback id="file-feedback" name="{{name}}"/></view>
  <button wx:if="{{canOpenPdf}}" class="primary-button" bindtap="onOpenPdf">{{openPdfText}}</button>
</view>
