/* file-reader 皮肤（状态）—— 宿主自有：颜色、间距、文案排布都在这里改，模块同步不会覆盖本目录。 */

.reader-loading {
  display: flex;
  align-items: center;
  gap: 18rpx;
  box-sizing: border-box;
  margin: 20rpx 24rpx;
  padding: 18rpx 22rpx;
  border: 2rpx solid #171715;
  border-radius: 18rpx;
  color: #2c2b28;
  background: #f3f5e7;
  font-size: 24rpx;
}

.loading-dot {
  flex: 0 0 auto;
  width: 18rpx;
  height: 18rpx;
  border: 4rpx solid rgba(23, 23, 21, 0.18);
  border-top-color: #78a800;
  border-radius: 50%;
  animation: reader-loading-spin 0.8s linear infinite;
}

.loading-copy,
.loading-label,
.loading-detail {
  display: block;
}

.loading-copy {
  min-width: 0;
}

.loading-label {
  font-weight: 700;
}

.loading-detail {
  margin-top: 4rpx;
  color: #777268;
  font-size: 21rpx;
  line-height: 1.45;
}

.error-card {
  margin: 22rpx 24rpx;
  padding: 20rpx 22rpx;
  border: 3rpx solid #171715;
  border-radius: 20rpx;
  color: #7f2119;
  background: #ffe7df;
  box-shadow: 6rpx 6rpx 0 #ff5b43;
  font-size: 24rpx;
  line-height: 1.55;
}

.native-status {
  margin: 32rpx 28rpx;
  padding: 28rpx;
  border: 3rpx solid #171715;
  border-radius: 22rpx;
  color: #3d3a35;
  background: #f3f5e7;
  font-size: 26rpx;
  line-height: 1.6;
}

@keyframes reader-loading-spin {
  to { transform: rotate(360deg); }
}

.error-card .retry-button {
  display: block;
  width: 160rpx;
  margin: 20rpx 0 0;
  color: #171715;
  background: #b9e63b;
  border: 2rpx solid #171715;
  border-radius: 16rpx;
  font-size: 26rpx;
}
