.file-queue {
  position: fixed; z-index: 30; right: 20rpx; left: 20rpx;
  bottom: calc(12rpx + env(safe-area-inset-bottom));
  display: flex; align-items: center; box-sizing: border-box;
  height: 92rpx; padding: 8rpx;
  border: 1rpx solid rgba(23,23,21,.18); border-radius: 999rpx;
  background: #fffdf8; box-shadow: 0 4rpx 20rpx rgba(23,23,21,.1);
}
.file-queue .queue-button {
  flex: 0 0 176rpx; width: 176rpx; min-width: 0; box-sizing: border-box;
  margin: 0; padding: 0 12rpx; border: 0; border-radius: 999rpx;
  color: #171715; background: #b9e63b; font-size: 27rpx; font-weight: 800;
  line-height: 72rpx; white-space: nowrap;
}
.file-queue .queue-button::after, .queue-position::after, .queue-close::after, .queue-item::after { border: 0; }
.file-queue .queue-button[disabled] { color: #a9a69e; background: #f5f3ee; }
.file-queue .queue-position {
  flex: 1; min-width: 0; margin: 0; padding: 0 8rpx;
  border: 0; background: transparent; color: #45483a;
  line-height: 72rpx; white-space: nowrap; text-align: center; font-size: 26rpx; font-weight: 600;
}
.queue-backdrop { position: fixed; inset: 0; z-index: 40; background: rgba(0,0,0,.28); animation: queue-fade-in .18s ease-out; }
.queue-drawer {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 41;
  box-sizing: border-box; padding: 28rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #fffdf8; border-radius: 28rpx 28rpx 0 0;
  animation: queue-slide-in .18s ease-out;
}
.queue-drawer.queue-closing { animation: queue-slide-out .18s ease-in forwards; }
.queue-backdrop.queue-closing { animation: queue-fade-out .18s ease-in forwards; }
.queue-heading { display: flex; justify-content: space-between; align-items: center; font-size: 30rpx; font-weight: 600; }
.queue-heading .queue-close { margin: 0; padding: 0 14rpx; line-height: 64rpx; background: transparent; color: #57594e; font-size: 27rpx; font-weight: 400; }
.queue-search { margin: 16rpx 0; padding: 20rpx; border: 1rpx solid #dedbd2; border-radius: 14rpx; background: #f8f6ef; font-size: 28rpx; }
.queue-list { max-height: 55vh; }
.queue-list .queue-item {
  display: block; width: 100%; box-sizing: border-box; margin: 4rpx 0;
  padding: 22rpx 20rpx; line-height: 1.5; text-align: left;
  font-size: 28rpx; font-weight: 400; background: transparent;
  border: 0; border-radius: 12rpx; word-break: break-all;
}
.queue-list .queue-active { background: #edf4d9; font-weight: 600; }
@keyframes queue-slide-in { from { transform: translateY(100%); } to { transform: translateY(0); } }
@keyframes queue-slide-out { from { transform: translateY(0); } to { transform: translateY(100%); } }
@keyframes queue-fade-in { from { opacity: 0; } to { opacity: 1; } }
@keyframes queue-fade-out { from { opacity: 1; } to { opacity: 0; } }
