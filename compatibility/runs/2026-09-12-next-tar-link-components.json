  "standards": [
    {
      "url": "https://pubs.opengroup.org/onlinepubs/9799919799/basedefs/V1_chap04.html",
      "section": "Pathname Resolution",
      "interpretation": "Resolve intermediate symbolic links before processing remaining components; dot-dot refers to the predecessor directory parent. Read and native realpath provide the local oracle."
    }
  ],
  "formatCaveat": "Hard links to symbolic inodes are confirmed libarchive behavior. POSIX pax utility page returned HTTP 403 during this investigation; do not yet call this combination universally conforming USTAR.",
  "rootCauses": [
    "Lexical normalization removes parent components before traversing intermediate symbolic directories and validates away required existing-directory components.",
    "Hard links preserve a prior symbolic inode but relative targets must resolve at its current alias location; current resolver reuses the prior entry name."
  ],
