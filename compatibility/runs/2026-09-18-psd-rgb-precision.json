{
  "schemaVersion": 1,
  "id": "psd-integer-rgb-matte-precision",
  "testedAt": "2026-09-18T10:10:24.463980+00:00",
  "rootCause": "8/16-bit RGB and alpha were independently normalized before white-matte subtraction, introducing cancellation error that moved exact half-byte results below the rounding boundary.",
  "change": "Subtract integer color/alpha samples and scale the integer numerator before division. Preserve float32 linear-light conversion, alpha, opaque color and existing bounds.",
  "construction": {
    "generator": "scripts/probe-psd-rgb-precision.py",
    "producer": "psd-tools 1.18.0",
    "seed": 9182026,
    "files": 72,
    "width": 65,
    "height": 17,
    "axes": [
      "PSD1/PSB2",
      "8/16/32-bit RGB",
      "Raw/RLE/ZIP/ZIP prediction",
      "opaque, stratified alpha, exact half-byte boundaries"
    ],
    "sourceVerification": "Every saved channel plane round-trips byte-exact through independent psd-tools. Integer reference uses Python Fraction over actual saved samples; float controls use actual saved IEEE values before sRGB conversion.",
    "secondaryOracle": "psd-tools NumPy decode has at most one channel level of rounding difference on visible pixels; retain this as lower-precision evidence, not an exact oracle.",
    "witness": "16-bit color=383 alpha=65280: ((383+65280-65535)*255)/65280 = 0.5, rounding to byte1. Old normalized subtraction computes0.4999999999999982, rounding to0."
  },
