  "specification": {
    "title": "Adobe Encapsulated PostScript File Format Specification 3.0",
    "url": "https://printtechnologies.org/standards/files/epsf_spec_v3_0.pdf",
    "sha256": "4b64ffdc177d61531c103ad55888991273dc7c61675226a2c6a2681c818e8e32",
    "sections": [
      "2.9 printed p9: CR, LF, CR LF and LF CR permitted",
      "6 printed p21: preview row alignment, nonhex filtering and wrapped lines"
    ],
    "scope": "Changing allowed line terminators must not alter preview bytes or reject the data. LF JPEG equivalence is a metamorphic check, not independent lossless image proof."
  },
  "generator": "const fs=require('fs'),path=require('path'),crypto=require('crypto');const root=process.cwd();\nconst {extractLegacyAiRasterPreview}=require(path.join(root,'miniprogram/file-reader/engine/core/design-file'));\nconst results=[];\nfor(const depth of [1,2,4,8])for(const wrap of ['row','byte','joined']) {\n const width=13,height=3,stride=Math.ceil(width*depth/8),packed=Buffer.alloc(stride*height);\n for(let y=0;y<height;y++)for(let x=0;x<width;x++){const max=(1<<depth)-1,sample=y===0?0:y===1?max:Math.floor(x*max/(width-1));const bit=x*depth;packed[y*stride+(bit>>3)]|=sample<<(8-depth-(bit%8))}\n const hex=packed.toString('hex'),size=wrap==='row'?stride*2:wrap==='byte'?2:hex.length;\n const data=[];for(let i=0;i<hex.length;i+=size)data.push('% '+hex.slice(i,i+size));\n let baseline;\n for(const [label,eol] of [['lf','\\n'],['cr','\\r'],['crlf','\\r\\n'],['lfcr','\\n\\r']]) {\n  const lines=['%!PS-Adobe-3.0 EPSF-3.0','%%BoundingBox: 0 0 13 3','%%EndComments',`%%BeginPreview: ${width} ${height} ${depth} ${data.length}`,...data,'%%EndPreview','%%EOF'];\n  const bytes=Buffer.from(lines.join(eol)+eol),name=`depth${depth}-${wrap}-${label}`,file=path.join(root,'outputs/next-epsi-lines',name+'.ai');fs.writeFileSync(file,bytes);\n  const row={name,width,height,depth,wrap,eol:label,sourceSha256:crypto.createHash('sha256').update(bytes).digest('hex')};\n  try {const r=extractLegacyAiRasterPreview(bytes);row.jpegSha256=crypto.createHash('sha256').update(r.jpeg).digest('hex');if(label==='lf')baseline=row.jpegSha256;row.exactToLF=row.jpegSha256===baseline;fs.writeFileSync(file+'.jpg',r.jpeg)}catch(e){row.error=e.message}\n  results.push(row);\n }\n}\nfs.writeFileSync('outputs/next-epsi-lines/report.json',JSON.stringify({cases:results.length,failures:results.filter(r=>r.error||!r.exactToLF).length,results},null,2)+'\\n');console.log({cases:results.length,failures:results.filter(r=>r.error||!r.exactToLF).length})\n",
  "componentProbe": "const fs=require('fs'),path=require('path'),assert=require('assert');const {designPreview}=require(path.join(process.cwd(),'tests/helpers/reader-host'));\nconst report=require('./report.json'),out=path.resolve('outputs/next-epsi-lines');const page=designPreview({env:{USER_DATA_PATH:out},getFileSystemManager:()=>({\n readFile(o){const b=fs.readFileSync(o.filePath).subarray(o.position||0,(o.position||0)+o.length);o.success({data:b.buffer.slice(b.byteOffset,b.byteOffset+b.byteLength)})},\n writeFile(o){fs.writeFileSync(o.filePath,Buffer.from(o.data));o.success()}\n})});\n(async()=>{const rows=[];for(const r of report.results){const file=path.join(out,r.name+'.ai');page.open({name:r.name+'.ai',path:file,size:fs.statSync(file).size});for(let i=0;i<8;i++)await new Promise(resolve=>setImmediate(resolve));const row={name:r.name,preview:!!page.data.previewPath,loading:page.data.loading,error:page.data.error,message:page.data.message};assert.equal(row.loading,false);if(r.error)assert.equal(row.preview,false);else assert.ok(row.preview);rows.push(row)}fs.writeFileSync(path.join(out,'component.json'),JSON.stringify({cases:rows.length,visible:rows.filter(r=>r.preview).length,results:rows},null,2)+'\\n');console.log({cases:rows.length,visible:rows.filter(r=>r.preview).length})})().catch(e=>{console.error(e);process.exitCode=1});\n",
  "finding": "Only CR-terminated multi-line data fails: split(/\\r?\\n/) leaves one physical line. CR-only single-line preview succeeds. All 40 remaining cases produce byte-identical JPEGs to LF controls; actual component confirms 8 missing previews.",
