      "generator": "import fs from 'node:fs'\nimport {initializeImageMagick,ImageMagick,MagickFormat,CompressionMethod,ColorType} from './magick/node_modules/@imagemagick/magick-wasm/dist/index.js'\nawait initializeImageMagick(fs.readFileSync(new URL('./magick/node_modules/@imagemagick/magick-wasm/dist/x86/magick.wasm',import.meta.url)))\nconst rows=[]\nfor(const [label,compression] of [['raw',CompressionMethod.NoCompression],['rle',CompressionMethod.RLE],['zip',CompressionMethod.Zip]]){\n try { ImageMagick.read(fs.readFileSync('outputs/next-psd-bitmap/bitmap-v1-w9-c0.psd'),image=>{image.colorType=ColorType.Bilevel;image.depth=1;image.setCompression(compression);image.write(MagickFormat.Psd,data=>{fs.writeFileSync('outputs/next-psd-bitmap/export-'+label+'.psd',data);const b=Buffer.from(data),row={label,depth:b.readUInt16BE(22),mode:b.readUInt16BE(24),bytes:b.length};try{row.roundtrip=ImageMagick.read(data,im=>({width:im.width,height:im.height,rgba:im.getPixels(p=>Array.from(p.toByteArray(0,0,im.width,im.height,'RGBA')))}))}catch(e){row.error=e.message}rows.push(row)})}) }catch(e){rows.push({label,error:e.message})}\n}\nfs.writeFileSync('outputs/next-psd-bitmap/magick-export.json',JSON.stringify(rows,null,2)+'\\n');console.log(rows)\n",
