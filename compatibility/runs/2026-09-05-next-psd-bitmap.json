  "generator": "import struct,zlib,json,hashlib,importlib.metadata\nfrom pathlib import Path\nfrom PIL import Image\nfrom psd_tools import PSDImage\nout=Path('outputs/next-psd-bitmap');rows=[]\nfor version in [1,2]:\n for width in [1,7,8,9,17,31]:\n  height=3;stride=(width+7)//8\n  raw=bytes([0]*stride+[255]*stride+[0xAA if i%2==0 else 0x55 for i in range(stride)])\n  for compression in [0,1,2]:\n   name=f'bitmap-v{version}-w{width}-c{compression}';path=out/(name+('.psd' if version==1 else '.psb'))\n   header=b'8BPS'+struct.pack('>H',version)+b'\\0'*6+struct.pack('>HIIHH',1,height,width,1,0)+b'\\0'*8+b'\\0'*(8 if version==2 else 4)+struct.pack('>H',compression)\n   if compression==0: data=raw\n   elif compression==1:\n    packets=[bytes([stride-1])+raw[i*stride:(i+1)*stride] for i in range(height)]\n    data=b''.join(struct.pack('>I' if version==2 else '>H',len(p)) for p in packets)+b''.join(packets)\n   else:data=zlib.compress(raw)\n   path.write_bytes(header+data)\n   row={'name':name,'path':str(path),'version':version,'width':width,'height':height,'depth':1,'compression':compression,'sourceSha256':hashlib.sha256(header+data).hexdigest()}\n   for oracle in ['pillow','psd-tools']:\n    try:\n     image=Image.open(path) if oracle=='pillow' else PSDImage.open(path).topil()\n     row[oracle]={'mode':image.mode,'size':image.size,'rgba':list(image.convert('RGBA').tobytes())}\n    except Exception as e:row[oracle]={'error':str(e)}\n   rows.append(row)\n(out/'oracles.json').write_text(json.dumps({'versions':{x:importlib.metadata.version(x) for x in ['Pillow','psd-tools']},'results':rows},indent=2)+'\\n')\nprint(json.dumps({'cases':len(rows),'successful':{x:sum('rgba' in r[x] for r in rows) for x in ['pillow','psd-tools']},'first':rows[0]},ensure_ascii=False))\n",
