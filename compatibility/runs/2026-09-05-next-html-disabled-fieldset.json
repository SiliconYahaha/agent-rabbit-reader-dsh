  "dynamic": {
    "source": "<!doctype html><form id=\"form\"><fieldset id=\"fs\"><legend id=\"first\">First</legend><legend id=\"second\">Second</legend><input id=\"target\" name=\"answer\" value=\"yes\"></fieldset></form><output id=\"out\"></output><script>const target=document.getElementById('target'), fs=document.getElementById('fs'), first=document.getElementById('first'), second=document.getElementById('second');const states=[];function snapshot(name){states.push({name,disabledProperty:target.disabled,disabledSelector:target.matches(':disabled'),pairs:Array.from(new FormData(document.getElementById('form')))});}snapshot('enabled');fs.disabled=true;snapshot('disabled');first.appendChild(target);snapshot('first-legend');second.appendChild(target);snapshot('second-legend');fs.insertBefore(second,first);snapshot('reorder-legends');fs.disabled=false;snapshot('enabled-again');document.getElementById('out').textContent=JSON.stringify(states);</script>",
